# Database (required)
# Use a hosted PostgreSQL URL (e.g. Neon, Supabase, Railway, Vercel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sqrclimb?sslmode=require"

# Session secret - generate a long random string (min 32 chars)
# openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Admin access secret (used to protect /admin routes)
ADMIN_SECRET="change-me-admin-secret"

# Optional: App URL for production
NEXT_PUBLIC_APP_URL="http://localhost:3000"
