generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RunStatus {
  PENDING
  VALIDATED
  FLAGGED
  REJECTED
}

enum RewardStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id            String     @id @default(cuid())
  username      String     @unique
  walletAddress String     @unique
  pinHash       String
  bestHeight    Int        @default(0)
  status        UserStatus @default(ACTIVE)
  isAdmin       Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions Session[]
  runs     GameRun[]
  rewards  Reward[]

  @@index([bestHeight(sort: Desc)])
  @@index([walletAddress])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model GameRun {
  id               String    @id @default(cuid())
  userId           String
  height           Int
  duration         Int
  acorns           Int       @default(0)
  goldenAcorns     Int       @default(0)
  startedAt        DateTime
  endedAt          DateTime
  status           RunStatus @default(PENDING)
  validationReason String?
  clientSeed       String?
  maxJumpHeight    Int?
  platformsLanded  Int?
  enemiesHit       Int?
  metadata         Json?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([height(sort: Desc)])
  @@index([createdAt])
}

model Reward {
  id              String       @id @default(cuid())
  userId          String
  rank            Int
  amount          String
  walletAddress   String
  status          RewardStatus @default(PENDING)
  transactionHash String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model RewardConfig {
  id        String   @id @default(cuid())
  rank      Int      @unique
  amount    String
  updatedAt DateTime @updatedAt
}

model AdminLog {
  id        String   @id @default(cuid())
  action    String
  details   Json?
  createdAt DateTime @default(now())
}
